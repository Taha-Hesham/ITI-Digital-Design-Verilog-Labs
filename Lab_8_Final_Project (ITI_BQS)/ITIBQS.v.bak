
`timescale 10ns / 1ns
//###############################################################################
/* ITI Verilog Course 
 AUTHOR:  Assoc.Prof. Ahmed Shalaby,	 DATE:	11/2025
 https://bu.edu.eg/staff/ahmedshalaby14
 Project: ITIBQS
 Module Name :  ITIBQS   
 Description:  top module integrates all sub modules in the design 
*/
//###############################################################################
/* ------------------------  Module Declarations ----------------------------- */
module ITIBQS (  rstn, clk, frontSensorInput, backSensorInput, tellers, 
				 emptyFlag, fullFlag, emptyAlarm, fullAlarm,
				 pCountDisplay, waitTimeDisplay_1, waitTimeDisplay_2);
// ------------------------ Parameter Declarations --------------------------- //
parameter counterwidth = 3;			
// -------------------------- Inputs Declarations ---------------------------- //
input rstn, clk;
// front and back queue sensor inputs
input frontSensorInput, backSensorInput;
// show attendence of tellers / In or Out 
input [2:0] tellers;
// ------------------------- Outputs Declarations ---------------------------- //
// empty and full flags 
output emptyFlag, fullFlag; 
// alarm signals for empty and full vilotions.
output emptyAlarm, fullAlarm; 
// seven segments display 
output [6:0] pCountDisplay, waitTimeDisplay_1, waitTimeDisplay_2; 
// --------------------------- Wire Declarations ----------------------------- //
// events from front and back sensors coming for edge detectors modules. 
wire leaveSensorEvent, enterSensorEvent;
// customers number from the up down counter. 
wire [counterwidth-1:0] pCount;
// control signal 
wire enable, upDown;
// address of wait time rom
wire [4:0] addr; 
// teller count in binary 
wire [1:0] tellersCount;
// wait time data 
wire [7:0] data;
// ---------------------------- Reg Declarations ----------------------------- //
// --------------------------------------------------------------------------- //
// ---------------------------- Initial setup  ------------------------------- //
// --------------------------------------------------------------------------- //
// ------------------------- Instantiation Modules --------------------------- //
// front sensor edge detector 
edgeDetector frontSensorEdgeDetect( frontSensorInput, rstn, clk, leaveSensorEvent);
// back sensor edge detector 
edgeDetector backSensorEdgeDetect( backSensorInput, rstn, clk, enterSensorEvent);
// customers counter 
upDownCounter customersCounter ( rstn,clk,enable,upDown,pCount);
// fsm controller for ITIBQS 
controllerFSM controllerBQS ( rstn, clk, leaveSensorEvent, enterSensorEvent, pCount,
					enable, upDown, emptyFlag, fullFlag, emptyAlarm, fullAlarm);
// waiting time rom 
waitTime_rom waitTimeRom (addr, data);
// display unit for customers
sevenSegmentsDecoder customersDisplay ({1'b0,pCount},pCountDisplay );
// display unit for waiting time 
sevenSegmentsDecoder waitDisplay_1 ( data[3:0], waitTimeDisplay_1);
sevenSegmentsDecoder waitDisplay_2 ( data[7:4], waitTimeDisplay_2);
// --------------------------------------------------------------------------- //
// ----------------------- Combinational Logic  ------------------------------ //
assign tellersCount = tellers[2] + tellers[1] + tellers[0];
// address combines tellers numbers and customers number
assign addr = {tellersCount, pCount};
// --------------------------------------------------------------------------- //
// ----------------------- Sequential  Logic  -------------------------------- //
// --------------------------------------------------------------------------- //
// --------------------------------------------------------------------------- //
endmodule
// ----------------------------- End of File --------------------------------- //